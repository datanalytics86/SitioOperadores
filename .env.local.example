# ─────────────────────────────────────────────
# OperadoresFaena.cl — Variables de entorno
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA commitees .env.local al repositorio.
# ─────────────────────────────────────────────

# Supabase (obligatorias)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...replace-me

# ADVERTENCIA: service_role bypasea RLS. Solo server-side / edge functions.
# NUNCA exponer al cliente ni commitear.
# SUPABASE_SERVICE_ROLE_KEY=

# Feature flags
# NEXT_PUBLIC_USE_MOCKS=true   # Solo desarrollo: muestra vacantes mock si DB vacía

# Rate limiting distribuido (opcional — prod multi-instance)
# Sin estas vars se usa store en memoria (ok en single-instance / dev)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Observabilidad (FASE 4)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Pagos (FASE 5) — Transbank Webpay Plus
# TRANSBANK_COMMERCE_CODE=
# TRANSBANK_API_KEY=
# TRANSBANK_ENV=integration
